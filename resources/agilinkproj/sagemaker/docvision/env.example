# Copy to .env and fill in. NEVER commit the real .env (it's in .gitignore).
# Load it in the SageMaker / LECT shell with:  set -a; source .env; set +a

# Needed for gated models (all Gemma 3 and Gemma 4 repos).
# Create a read token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where weights are downloaded. The full 18-model set is ~577 GB at bf16, so point
# this at a volume with >= 750 GB free. On SageMaker notebook instances,
# /home/ec2-user/SageMaker is persistent EBS - size the volume accordingly.
MODEL_ROOT=/home/ec2-user/SageMaker/vlm-bench/models

# Faster downloads for the large weight set (pip install hf_transfer first):
HF_HUB_ENABLE_HF_TRANSFER=1

# Keep the HF cache off the small root disk too:
# HF_HOME=/home/ec2-user/SageMaker/hf-cache

# Enforce the "single H100" constraint on a multi-GPU instance (e.g. an 8x H100
# ml.p5): expose only one GPU so device_map="auto" uses a single card.
CUDA_VISIBLE_DEVICES=0
